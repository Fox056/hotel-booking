{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.v1",
  "description": "Messages of the Kafka topic booking.v1: the public state of a booking.",
  "$defs": {
    "BookingState": {
      "description": "Public state of a booking.",
      "type": "object",
      "required": ["hotel_id", "booking_id", "status", "refund_status"],
      "properties": {
        "hotel_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"},
        "booking_id": {"type": "string", "format": "uuid", "maxLength": 36},
        "check_in_date": {"type": "string", "format": "date"},
        "rooms": {"type": "integer", "minimum": 1, "maximum": 5},
        "nights": {"type": "integer", "minimum": 1, "maximum": 30},
        "amount": {"type": "integer", "minimum": 1, "maximum": 15000000000},
        "dates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"type": "string", "format": "date"}
        },
        "room_type_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"}
        },
        "status": {"type": "string", "enum": ["pending_payment", "confirmed", "not_confirmed", "cancelled"]},
        "refund_status": {"type": "string", "enum": ["none", "in_progress", "completed", "failed"]}
      },
      "additionalProperties": false
    }
  }
}
