{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message envelope v1",
  "description": "The envelope of Kafka events and RabbitMQ commands: the JSON object in the message body. $defs/Envelope is the open general form that a receiver relies on.",
  "$defs": {
    "Envelope": {
      "description": "General form of any message. A receiver ignores members it does not know, at any depth.",
      "type": "object",
      "required": ["message_id", "type", "created_at", "payload"],
      "properties": {
        "message_id": {"$ref": "#/$defs/MessageId"},
        "type": {"$ref": "#/$defs/MessageType"},
        "created_at": {"$ref": "#/$defs/CreatedAt"},
        "headers": {
          "description": "Cross-service headers from the list of the contract.",
          "type": "object",
          "properties": {
            "pii_retain_until": {"$ref": "#/$defs/PiiRetainUntil"},
            "traceparent": {"$ref": "#/$defs/Traceparent"}
          }
        },
        "version": {
          "description": "Version of the state of the message key, as in KeyVersion but open.",
          "type": "object",
          "required": ["epoch", "number"],
          "properties": {
            "epoch": {"type": "integer", "minimum": 1, "maximum": 9999},
            "number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "snapshot": {"type": "boolean"}
          }
        },
        "payload": {
          "description": "Data of the message type.",
          "type": "object"
        }
      }
    },
    "MessageId": {
      "description": "Message id: UUID v7 in lowercase, the id of the outbox row.",
      "type": "string",
      "format": "uuid",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "MessageType": {
      "description": "Message type: <area>.<name>.v<major>.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*\\.v[1-9][0-9]{0,2}(?![\\s\\S])"
    },
    "CreatedAt": {
      "description": "Creation time of the outbox row in UTC, with milliseconds: YYYY-MM-DDThh:mm:ss.sssZ.",
      "type": "string",
      "format": "date-time",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "PiiRetainUntil": {
      "description": "Deadline for the personal data of the message, in UTC without a fraction of a second.",
      "type": "string",
      "format": "date-time",
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "Traceparent": {
      "description": "W3C traceparent of the publisher, version 00.",
      "type": "string",
      "maxLength": 55,
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}(?![\\s\\S])"
    },
    "EventHeaders": {
      "description": "Headers of an event.",
      "type": "object",
      "properties": {
        "traceparent": {"$ref": "#/$defs/Traceparent"}
      },
      "additionalProperties": false
    },
    "KeyVersion": {
      "description": "Version of the state of the message key.",
      "type": "object",
      "required": ["epoch", "number"],
      "properties": {
        "epoch": {"type": "integer", "minimum": 1, "maximum": 9999},
        "number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    }
  }
}
