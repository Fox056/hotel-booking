{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.v1",
  "description": "Messages of the Kafka topic booking.v1: the public state of a booking.",
  "$defs": {
    "booking.state.v1": {
      "description": "Full state of the key (hotel, booking) with its version.",
      "type": "object",
      "required": ["message_id", "type", "created_at", "version", "payload"],
      "properties": {
        "message_id": {"$ref": "../schemas/envelope.v1.json#/$defs/MessageId"},
        "type": {"type": "string", "enum": ["booking.state.v1"]},
        "created_at": {"$ref": "../schemas/envelope.v1.json#/$defs/CreatedAt"},
        "headers": {"$ref": "../schemas/envelope.v1.json#/$defs/EventHeaders"},
        "version": {"$ref": "../schemas/envelope.v1.json#/$defs/KeyVersion"},
        "payload": {"$ref": "#/$defs/BookingState"}
      },
      "additionalProperties": false
    },
    "booking.cancelled.v1": {
      "description": "The booking was cancelled; the payload is its state after the cancellation.",
      "type": "object",
      "required": ["message_id", "type", "created_at", "version", "payload"],
      "properties": {
        "message_id": {"$ref": "../schemas/envelope.v1.json#/$defs/MessageId"},
        "type": {"type": "string", "enum": ["booking.cancelled.v1"]},
        "created_at": {"$ref": "../schemas/envelope.v1.json#/$defs/CreatedAt"},
        "headers": {"$ref": "../schemas/envelope.v1.json#/$defs/EventHeaders"},
        "version": {"$ref": "../schemas/envelope.v1.json#/$defs/KeyVersion"},
        "payload": {"$ref": "#/$defs/BookingState"}
      },
      "additionalProperties": false
    },
    "BookingKey": {
      "description": "Record key: {hotel_id}:{booking_id}.",
      "type": "string",
      "maxLength": 73,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "Id": {
      "description": "Id, a UUID in lowercase.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "BookingState": {
      "description": "Public state of a booking.",
      "type": "object",
      "required": ["hotel_id", "booking_id", "status", "payment_outcome_unresolved", "refund_status"],
      "properties": {
        "hotel_id": {"$ref": "#/$defs/Id"},
        "booking_id": {"$ref": "#/$defs/Id"},
        "status": {"type": "string", "enum": ["pending_payment", "confirmed", "not_confirmed", "cancelled"]},
        "payment_outcome_unresolved": {"type": "boolean"},
        "refund_status": {"type": "string", "enum": ["none", "in_progress", "completed", "failed"]}
      },
      "additionalProperties": false
    }
  }
}
