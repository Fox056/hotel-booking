{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.v1",
  "description": "Messages of the Kafka topic booking.v1: the public state of a booking.",
  "$defs": {
    "AnyButNotCharged": {
      "description": "Any outcome but not_charged.",
      "type": "object",
      "not": {
        "type": "object",
        "required": ["outcome"],
        "properties": {
          "outcome": {"type": "string", "enum": ["not_charged"]}
        },
        "additionalProperties": false
      }
    },
    "BookingId": {
      "description": "Id, a UUID in lowercase.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "EntityId": {
      "description": "Id, a UUID in lowercase.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "RefundAttempt": {
      "description": "Number of the refund attempt of a booking: 1 for the first one.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "BookingState": {
      "description": "Public state of a booking.",
      "type": "object",
      "required": ["hotel_id", "booking_id", "status", "refund_status"],
      "properties": {
        "hotel_id": {"$ref": "#/$defs/EntityId"},
        "booking_id": {"$ref": "#/$defs/BookingId"},
        "status": {"type": "string", "enum": ["pending_payment", "confirmed", "not_confirmed", "cancelled"]},
        "refund_status": {"type": "string", "enum": ["none", "in_progress", "completed", "failed"]},
        "refund_attempt": {
          "description": "The latest refund attempt; booking retries a refund at most ten times.",
          "type": "integer",
          "allOf": [
            {"$ref": "#/$defs/RefundAttempt"},
            {"type": "integer", "maximum": 10}
          ]
        },
        "payment_outcome": {"$ref": "#/$defs/PaymentOutcome"}
      },
      "additionalProperties": false
    },
    "PaymentOutcome": {
      "description": "What booking knows about the payment of a booking.",
      "type": "object",
      "oneOf": [
        {"$ref": "#/$defs/OutcomeCharged"},
        {"$ref": "#/$defs/OutcomeNotCharged"}
      ]
    },
    "OutcomeCharged": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": {"type": "string", "enum": ["charged"]}
      },
      "additionalProperties": false
    },
    "OutcomeNotCharged": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": {"type": "string", "enum": ["not_charged"]}
      },
      "additionalProperties": false
    }
  }
}
