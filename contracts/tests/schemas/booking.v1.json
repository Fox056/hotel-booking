{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking.v1 stub for lint fixtures",
  "description": "Test helper: a small stand-in for ../../schemas/booking.v1.json, used by the fixtures in ../rules/. It lies at the same relative path, so the fixtures reference it exactly as the contracts reference the real file. booking.v1 is a compacted topic, so its message carries the key version. The first four entries are the correct ones; every entry after them is a variant for the violating fixture named in its description.",
  "$defs": {
    "booking.state.v1": {
      "type": "object",
      "required": ["message_id", "type", "created_at", "version", "payload"],
      "properties": {
        "message_id": {"$ref": "../schemas/envelope.v1.json#/$defs/MessageId"},
        "type": {"type": "string", "enum": ["booking.state.v1"]},
        "created_at": {"$ref": "../schemas/envelope.v1.json#/$defs/CreatedAt"},
        "headers": {"$ref": "../schemas/envelope.v1.json#/$defs/EventHeaders"},
        "version": {"$ref": "../schemas/envelope.v1.json#/$defs/KeyVersion"},
        "payload": {"$ref": "#/$defs/BookingState"}
      },
      "additionalProperties": false
    },
    "BookingKey": {
      "type": "string",
      "maxLength": 73,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "BookingState": {
      "type": "object",
      "required": ["hotel_id", "booking_id", "status"],
      "properties": {
        "hotel_id": {"$ref": "#/$defs/Id"},
        "booking_id": {"$ref": "#/$defs/Id"},
        "status": {"type": "string", "enum": ["pending_payment", "confirmed", "not_confirmed", "cancelled"]}
      },
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "KeyWithoutHotel": {
      "description": "contracts--event-envelope--key-without-hotel: the key is the booking alone, without the hotel in front.",
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "MessageWithInlineMessageId": {
      "description": "contracts--event-envelope--inline-envelope-field: message_id is described in place instead of a $ref to the envelope.",
      "type": "object",
      "required": ["message_id", "type", "created_at", "version", "payload"],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "type": {"type": "string", "enum": ["booking.state.v1"]},
        "created_at": {"$ref": "../schemas/envelope.v1.json#/$defs/CreatedAt"},
        "headers": {"$ref": "../schemas/envelope.v1.json#/$defs/EventHeaders"},
        "version": {"$ref": "../schemas/envelope.v1.json#/$defs/KeyVersion"},
        "payload": {"$ref": "#/$defs/BookingState"}
