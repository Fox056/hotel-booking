{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Details stub for lint fixtures",
  "description": "Test helper: a small stand-in for ../../schemas/problem-details.v1.json, used by the fixtures in ../rules/. It lies at the same relative path, so the fixtures reference it exactly as the contracts reference the real file.",
  "$defs": {
    "TraceId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(?!0{32})[0-9a-f]{32}(?![\\s\\S])"
    },
    "about_blank": {
      "type": "object",
      "required": ["type", "title", "status"],
      "properties": {
        "type": {"type": "string", "enum": ["about:blank"]},
        "title": {"type": "string", "maxLength": 100},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    },
    "about_blank_traced": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id"],
      "properties": {
        "type": {"type": "string", "enum": ["about:blank"]},
        "title": {"type": "string", "maxLength": 100},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    },
    "idempotency_key_missing": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#idempotency_key_missing"]},
        "title": {"type": "string", "enum": ["Idempotency key missing"]},
        "status": {"type": "integer", "enum": [400]},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    },
    "idempotency_key_mismatch": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#idempotency_key_mismatch"]},
        "title": {"type": "string", "enum": ["Idempotency key mismatch"]},
        "status": {"type": "integer", "enum": [422]},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    },
    "validation_error": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id", "errors"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#validation_error"]},
        "title": {"type": "string", "enum": ["Validation error"]},
        "status": {"type": "integer", "enum": [422]},
        "trace_id": {"$ref": "#/$defs/TraceId"},
        "errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["pointer", "code"],
            "properties": {
              "pointer": {"type": "string", "maxLength": 200},
              "code": {"type": "string", "maxLength": 64}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "no_availability": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#no_availability"]},
        "title": {"type": "string", "enum": ["No availability"]},
        "status": {"type": "integer", "enum": [409]},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    },
    "amount_changed": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id", "current_amount"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#amount_changed"]},
        "title": {"type": "string", "enum": ["Amount changed"]},
        "status": {"type": "integer", "enum": [409]},
        "trace_id": {"$ref": "#/$defs/TraceId"},
        "current_amount": {"type": "integer", "minimum": 1, "maximum": 15000000000}
      },
      "additionalProperties": false
    },
    "hold_finished": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#hold_finished"]},
        "title": {"type": "string", "enum": ["Hold finished"]},
        "status": {"type": "integer", "enum": [409]},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    },
    "hotel_not_found": {
      "type": "object",
      "required": ["type", "title", "status", "trace_id"],
      "properties": {
        "type": {"type": "string", "enum": ["https://example.org/problems#hotel_not_found"]},
        "title": {"type": "string", "enum": ["Hotel not found"]},
        "status": {"type": "integer", "enum": [404]},
        "trace_id": {"$ref": "#/$defs/TraceId"}
      },
      "additionalProperties": false
    }
  }
}
